# PostgreSQL connection string with SSL from Neon, backend/database.py
DATABASE_URL=
# Exact allowed frontend origins, comma-separated, backend/main.py
FRONTEND_URL=
# Bedrock and Knowledge Base region, services
AWS_REGION=
# Optional IAM key when not using a workload role or Bedrock bearer token, boto3
AWS_ACCESS_KEY_ID=
# IAM secret paired with access key, boto3
AWS_SECRET_ACCESS_KEY=
# Temporary IAM session token if using temporary credentials, boto3
AWS_SESSION_TOKEN=
# Alternative Bedrock API key; Knowledge Base access may require IAM, boto3
AWS_BEARER_TOKEN_BEDROCK=
# Bedrock model or inference profile ID, services
BEDROCK_MODEL_ID=
# Legacy fallback if BEDROCK_MODEL_ID is unset, services
MODEL_ID=
# Existing synced Bedrock Knowledge Base ID, kb_service.py
KNOWLEDGE_BASE_ID=
# Random secret of at least 32 characters, auth_service.py
JWT_SECRET_KEY=
# HS256, auth_service.py
JWT_ALGORITHM=
# Positive integer, default 60, auth_service.py
ACCESS_TOKEN_EXPIRE_MINUTES=
# Optional guide sync destination, scripts/sync_knowledge_base.py
KNOWLEDGE_BASE_S3_URI=
# Existing data source ID for ingestion, scripts/sync_knowledge_base.py
KNOWLEDGE_BASE_DATA_SOURCE_ID=
